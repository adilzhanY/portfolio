---
import { CV_DATA } from "../data/cv";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { name: "index", href: "/" },
  { name: "about", href: "/about" },
  { name: "contact", href: "/contact" },
];

const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="absolute inset-x-0 top-0 z-40 flex items-center justify-between px-6 py-6 md:px-10"
>
  <a
    href="/"
    class="ulink text-base font-semibold tracking-tight"
    aria-label="Home"
  >
    {CV_DATA.nickname}
  </a>

  <nav aria-label="Main">
    <ul class="flex items-center gap-6 md:gap-9">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class:list={[
                "ulink font-mono text-[0.7rem] uppercase tracking-[0.2em] transition-colors",
                isCurrent(item.href)
                  ? "text-paper"
                  : "text-paper/55 hover:text-paper",
              ]}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

---
import "../styles/global.css";
import Cursor from "../components/Cursor";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  /** The contact page is already a closing screen, so it hides the footer. */
  hideFooter?: boolean;
}

const {
  title,
  description = "Adilzhan Yerzhan — software engineer in Potsdam. Three products, built alone.",
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@400..700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body
    class="font-sans font-light antialiased selection:bg-paper selection:text-ink"
  >
    <!-- The single colour layer the whole site paints through. -->
    <div id="wash"></div>

    <SiteNav />
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <SiteFooter />}

    <Cursor client:load />

    <script>
      // One gesture per page, not a sequence. The colour change between pages
      // is the motion that carries this design; everything else stays still.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document
          .querySelectorAll<HTMLElement>("[data-rise]")
          .forEach((el, i) => {
            el.animate(
              [
                { opacity: 0, transform: "translateY(18px)" },
                { opacity: 1, transform: "translateY(0)" },
              ],
              {
                duration: 700,
                delay: 70 * i,
                easing: "cubic-bezier(0.16, 1, 0.3, 1)",
                fill: "backwards",
              }
            );
          });
      }
    </script>
  </body>
</html>

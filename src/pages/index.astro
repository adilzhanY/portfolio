---
import Base from "../layouts/Base.astro";
import { CV_DATA } from "../data/cv";

const projects = CV_DATA.projects;
---

<Base title={`${CV_DATA.name} — ${CV_DATA.nickname}`}>
  <section class="flex min-h-screen flex-col px-6 pb-10 pt-28 md:px-10 md:pt-32">
    <!-- The identity block is deliberately small. The work is the hero. -->
    <div data-rise class="shrink-0">
      <h1 class="text-lg font-semibold tracking-tight md:text-xl">
        {CV_DATA.name}
      </h1>
      <p class="label mt-2">
        software engineer &middot; {CV_DATA.location} &middot; open to work
      </p>
    </div>

    <!-- Three enormous reasons to stay. -->
    <ul id="work" class="mt-12 md:mt-16">
      {
        projects.map((project, i) => (
          <li class="work-row" data-accent={project.accent} data-rise>
            <div class="rule" />
            <a
              href={`/work/${project.slug}`}
              class="grid grid-cols-1 items-baseline gap-x-8 gap-y-3 py-6 md:grid-cols-[3rem_minmax(0,1fr)_20rem] md:py-7"
            >
              <span class="label md:pt-4">
                {String(i + 1).padStart(2, "0")}
              </span>

              <h2 class="work-title display text-[3.5rem] leading-[0.86] sm:text-[5rem] md:text-[7vw]">
                {project.title}
              </h2>

              <div class="work-meta md:pt-3">
                <p class="text-sm leading-relaxed text-paper/85 md:text-[0.95rem]">
                  {project.summary}
                </p>
                <p class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-paper/55">
                  {project.metric}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="rule"></div>

    <div
      data-rise
      class="mt-auto flex flex-col gap-2 pt-10 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-muted sm:flex-row sm:justify-between"
    >
      <span>three products, built alone</span>
      <span class="hidden sm:inline">open one &rarr;</span>
    </div>
  </section>
</Base>

<style>
  /* At rest the titles sit back; the row you are on comes forward and the
     others step aside. Colour is handled by #wash. */
  .work-title {
    color: rgb(237 235 231 / 0.38);
    transition: color 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-meta {
    opacity: 0.5;
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work-row:hover .work-title,
  .work-row:focus-within .work-title {
    color: var(--color-paper);
  }
  .work-row:hover .work-meta,
  .work-row:focus-within .work-meta {
    opacity: 1;
  }

  #work:hover .work-row:not(:hover),
  #work:focus-within .work-row:not(:focus-within) {
    opacity: 0.45;
  }
  .work-row {
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Touch devices never hover, so nothing should be dimmed there. */
  @media (hover: none) {
    .work-title {
      color: var(--color-paper);
    }
    .work-meta {
      opacity: 1;
    }
  }
</style>

<script>
  // Hovering a project floods the page with the colour that project owns.
  // The colour then follows you onto its page.
  const body = document.body;
  const rows = document.querySelectorAll<HTMLElement>(".work-row[data-accent]");

  const paint = (accent: string) => {
    body.style.setProperty("--wash", accent);
    body.style.setProperty("--wash-opacity", "1");
  };
  const clear = () => body.style.setProperty("--wash-opacity", "0");

  rows.forEach((row) => {
    const accent = row.dataset.accent;
    if (!accent) return;
    row.addEventListener("mouseenter", () => paint(accent));
    row.addEventListener("focusin", () => paint(accent));
    row.addEventListener("mouseleave", clear);
    row.addEventListener("focusout", clear);
  });
</script>

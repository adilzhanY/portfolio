---
import Base from "../layouts/Base.astro";
import { CV_DATA } from "../data/cv";

const { education, experience, skills } = CV_DATA;

/* The year is the display element here, so the section carries the same
   weight as the work index without inventing a new decoration for it. */
const entries = [
  ...experience.map((job) => ({
    year: job.date.match(/\d{4}/)?.[0] ?? job.date,
    title: `${job.company} — ${job.role}`,
    detail: job.bullets.join(" "),
    meta: job.location,
  })),
  {
    year: education.date.match(/\d{4}/)?.[0] ?? education.date,
    title: education.degree,
    detail: `${education.uni}. Final grade ${education.gpa}.`,
    meta: education.date,
  },
];
---

<Base title={`About — ${CV_DATA.name}`}>
  <section class="px-6 pt-28 md:px-10 md:pt-32">
    <p data-rise class="label">where I've worked</p>
    <h1
      data-rise
      class="display mt-4 text-[3.5rem] leading-[0.86] sm:text-[5rem] md:text-[9vw]"
    >
      The record
    </h1>

    <div class="mt-14 md:mt-20">
      {
        entries.map((entry) => (
          <div data-rise>
            <div class="rule" />
            <div class="grid gap-3 py-8 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-10 md:py-10">
              <span class="display text-[3rem] leading-none text-paper/70 md:text-[4.5rem]">
                {entry.year}
              </span>
              <div>
                <h2 class="text-xl font-medium md:text-2xl">{entry.title}</h2>
                <p class="mt-3 max-w-2xl leading-relaxed text-paper/65">
                  {entry.detail}
                </p>
                <p class="label mt-4">{entry.meta}</p>
              </div>
            </div>
          </div>
        ))
      }
      <div class="rule"></div>
    </div>

    <div data-rise class="mt-16 md:mt-24">
      <p class="label">what I reach for</p>
      <ul
        class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-lg text-paper/80 md:text-xl"
      >
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </div>
  </section>
</Base>
